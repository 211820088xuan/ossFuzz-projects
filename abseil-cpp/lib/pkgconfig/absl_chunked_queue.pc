prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_chunked_queue
Description: Abseil chunked_queue library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_core_headers = head, absl_iterator_traits_internal = head, absl_layout = head
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
