prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_string_view
Description: Abseil string_view library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_core_headers = head, absl_nullability = head
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
