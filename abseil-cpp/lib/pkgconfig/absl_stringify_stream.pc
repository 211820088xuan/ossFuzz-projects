prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_stringify_stream
Description: Abseil stringify_stream library
URL: https://abseil.io/
Version: head
Requires: absl_string_view = head, absl_config = head
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
