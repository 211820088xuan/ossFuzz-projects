prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_hardening
Description: Abseil hardening library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_core_headers = head
Libs: -L${libdir}  -labsl_hardening 
Cflags: -I${includedir} -DNOMINMAX
