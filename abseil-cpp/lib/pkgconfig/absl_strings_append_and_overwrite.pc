prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_strings_append_and_overwrite
Description: Abseil strings_append_and_overwrite library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_core_headers = head, absl_strings_resize_and_overwrite = head, absl_throw_delegate = head
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
